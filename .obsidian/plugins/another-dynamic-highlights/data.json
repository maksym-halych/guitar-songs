{
  "selectionHighlighter": {
    "highlightWordAroundCursor": true,
    "highlightSelectedText": true,
    "maxMatches": 100,
    "minSelectionLength": 3,
    "highlightDelay": 200,
    "ignoredWords": "about, after, all, also, and, any, as, at, back, be, because, before, but, by, can, come, could, day, do, down, each, even, find, first, for, from, get, give, go, good, great, have, he, I, if, in, into, it, just, know, like, long, look, make, man, many, may, more, most, much, must, new, no, not, now, of, on, one, only, or, other, out, over, own, people, say, see, she, should, so, some, state, such, take, than, that, the, then, there, these, they, think, this, through, time, to, up, use, way, we, well, what, when, where, which, who, will, with, work, would, year, you",
    "selectionColor": "default",
    "selectionDecoration": "default",
    "css": "text-decoration: underline dotted var(--text-accent)"
  },
  "staticHighlighter": {
    "showInReadingMode": false,
    "debugMode": false,
    "queries": {
      "chords": {
        "class": "chords",
        "staticColor": "#E0AF68",
        "staticDecoration": "color",
        "staticCss": {
          "fontWeight": "400",
          "color": "#E0AF68"
        },
        "colorIconSnippet": "font-weight: 400; color: #E0AF68",
        "regex": true,
        "query": "^[ \\t]*(?:[A-G][#b]?(?:maj|min|dim|aug|sus|add|m|M)?\\d*(?:sus[24]|add\\d+)?(?:\\/[A-G][#b]?)?[ \\t]*)+$",
        "mark": [
          "match"
        ],
        "highlighterEnabled": true,
        "tag": "#unsorted",
        "tagEnabled": true
      },
      "song segments": {
        "class": "song-segments",
        "staticColor": "#7AA2F7",
        "staticDecoration": "bold",
        "staticCss": {
          "fontWeight": "600",
          "color": "#7AA2F7"
        },
        "colorIconSnippet": "font-weight: 600; color: #7AA2F7",
        "regex": true,
        "query": "^\\[[^\\]]+\\]$",
        "mark": [
          "match"
        ],
        "highlighterEnabled": true,
        "tag": "#unsorted",
        "tagEnabled": true
      }
    },
    "queryOrder": [
      "song segments",
      "chords"
    ],
    "tagOrder": [],
    "expandedTags": [
      "#unsorted"
    ],
    "toggleable": [
      "#unsorted"
    ],
    "onOffSwitch": true
  }
}